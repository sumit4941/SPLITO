# Copy to .env for local development. Values are examples, never production
# credentials. The application validates these variables at startup.

NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false
# Vite's local proxy and Vercel's same-origin /api rewrite both use this origin.
# On Vercel, configure an HTTPS origin only (for example, https://api.example.com)
# and do not include /api/v1 or a trailing path.
SPLITO_API_ORIGIN=http://localhost:3000
# Compose overrides WEB_ORIGIN with this same-origin nginx endpoint.
SPLITO_WEB_ORIGIN=http://localhost:8080

# Runtime Oracle account: DML-only access to objects owned by SPLITO_OWNER.
# FREE is the CDB root; FREEPDB1 is the correct application service.
DATABASE_CONNECT_STRING=localhost:1521/FREEPDB1
DATABASE_USER=SPLITO_APP
DATABASE_OWNER_SCHEMA=SPLITO_OWNER
DATABASE_PASSWORD=
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=8
DATABASE_POOL_INCREMENT=1
DATABASE_QUEUE_TIMEOUT_MS=5000
DATABASE_CALL_TIMEOUT_MS=15000

# Database CLI scripts use Thin mode by default. API and worker intentionally
# support Thin mode only; set thick here only while running a documented CLI task.
SPLITO_ORACLE_MODE=thin
# SPLITO_ORACLE_CLIENT_LIB_DIR=C:\Oracle\instantclient_23_9

# Generate independent values with a cryptographically secure secret generator.
# Do not reuse a secret between fields or environments.
SESSION_PEPPER=
CSRF_SECRET=
# Keyed HMAC secret for short-lived mobile OTPs; never reuse another secret.
OTP_PEPPER=
# 32 random bytes encoded as 64 hexadecimal characters or supported base64url.
MFA_ENCRYPTION_KEY=
COOKIE_SECURE=false
# COOKIE_DOMAIN=localhost
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=720

# Development-only private media filesystem adapter. Production image uploads
# remain disabled until a private object-storage/scanning adapter is configured.
ATTACHMENT_STORAGE_PATH=./storage/private
# Maximum source upload size in bytes; image outputs are normalized to WebP.
MAX_UPLOAD_BYTES=10000000

OUTBOX_POLL_MS=1000
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=10

# Group-invitation SMS. Development always uses deterministic in-memory capture.
# Production requires SMS_PROVIDER=twilio, API-key credentials, and exactly one sender option.
# Configure Twilio spend limits, destination regions, and fraud controls before enabling it.
SMS_PROVIDER=disabled
SMS_REQUEST_TIMEOUT_MS=8000
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_E164=
TWILIO_MESSAGING_SERVICE_SID=

FX_PROVIDER=manual
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Migration account. Keep this secret out of API/worker environments.
SPLITO_MIGRATION_DB_CONNECT_STRING=localhost:1521/FREEPDB1
SPLITO_MIGRATION_DB_USER=SPLITO_OWNER
SPLITO_MIGRATION_DB_PASSWORD=
SPLITO_MIGRATION_LOCK_TIMEOUT_SECONDS=60
SPLITO_MIGRATION_LEASE_SECONDS=600
SPLITO_MIGRATION_CALL_TIMEOUT_MS=120000

# First bootstrap only. Set these in a temporary process environment, run the
# bootstrap, then unset them. Never place a real administrator password here.
SPLITO_ADMIN_DB_CONNECT_STRING=localhost:1521/FREEPDB1
SPLITO_ADMIN_DB_USER=SYSTEM
SPLITO_ADMIN_DB_PASSWORD=
SPLITO_DB_USER=SPLITO_APP
SPLITO_DB_PASSWORD=
SPLITO_DB_TABLESPACE=USERS
SPLITO_DB_QUOTA=1G
# Set only for an inspected partial bootstrap; existing passwords are not changed.
# SPLITO_REPAIR_EXISTING_USERS=true

# Development seed only. The default password is documented in the setup guide;
# override locally if desired. Never set this flag in production.
# SPLITO_ALLOW_DEVELOPMENT_SEED=true
# SPLITO_DEMO_PASSWORD=SplitoDemo!2026
# SPLITO_RESET_DEMO_PASSWORDS=false

# Development returns mobile OTPs in the API response for local testing only.
# Outside development, both OTPs and group invitations use the provider above.
