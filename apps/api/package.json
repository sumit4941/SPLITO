{
  "name": "@splito/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "predev": "npm run build --workspace @splito/config && npm run build --workspace @splito/domain && tsc -p tsconfig.json",
    "dev": "concurrently --kill-others-on-fail --names compiler,server --prefix-colors magenta,blue \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "prebuild": "npm run build --workspace @splito/config && npm run build --workspace @splito/domain",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build --workspace @splito/config && npm run build --workspace @splito/domain",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run --config vitest.config.ts",
    "pretest:integration": "npm run build --workspace @splito/config && npm run build --workspace @splito/domain",
    "test:integration": "node --env-file-if-exists=../../.env ../../node_modules/vitest/vitest.mjs run --config src/vitest.mongodb.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.7",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-fastify": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "@splito/config": "0.1.0",
    "@splito/domain": "0.1.0",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "mongodb": "7.8.0",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
